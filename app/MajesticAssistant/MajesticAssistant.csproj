<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <!-- Needed for System.Windows.Forms.NotifyIcon — WPF has no tray-icon API of its own, and
         NotifyIcon is the standard way to host one, isolated to Services/TrayIconService.cs so it
         never collides with WPF's own (differently-named) types elsewhere in the project. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MajesticAssistant</RootNamespace>
    <AssemblyName>MajesticAssistant</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- UseWindowsForms implicitly adds a project-wide "global using System.Windows.Forms;", which
       collides with WPF's identically-named types (Application, KeyEventArgs, MouseEventArgs, ...)
       in every file, not just the one that actually needs NotifyIcon. Remove the implicit global
       using; TrayIconService.cs already has its own local "using System.Windows.Forms;" and stays
       the only file that can see those types. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <!-- Ships the markdown knowledge base (data/kb, one level up from the repo root) next to the
       exe as a "kb" folder, so RagService can find it at AppContext.BaseDirectory + "kb" without
       depending on the source tree being present on the machine that runs the built app. -->
  <ItemGroup>
    <Content Include="..\..\data\kb\**\*.md">
      <Link>kb\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Copies a locally-downloaded whisper.cpp GGML model (see README — not committed to git, it's
       a multi-hundred-MB binary) into the build output next to the exe, same pattern as data/kb.
       Matches zero files (harmlessly) until whisper/*.bin actually exists on disk. -->
  <ItemGroup>
    <Content Include="whisper\**\*.bin">
      <Link>whisper\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- NAudio records the microphone to a WAV file; Whisper.net is the .NET binding for whisper.cpp
       (native CPU runtime pulled in by Whisper.net.Runtime) that transcribes it — both run fully
       locally, no cloud speech API, matching the rest of the app. The GGML model itself is NOT a
       NuGet package (same convention as Ollama's models): it's a separate multi-hundred-MB
       download the user places under whisper/ next to the exe — see the README. -->
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

</Project>
